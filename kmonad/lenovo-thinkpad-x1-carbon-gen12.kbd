(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "My KMonad output"
    ;; To understand the importance of the following line, see the section on
    ;; Compose-key sequences at the near-bottom of this file.

    ;; this is handled in nix/wayland/src/keyboard.xkb
    ;; "/run/current-system/sw/bin/sleep 1 && /run/current-system/sw/bin/setxkbmap -option compose:ralt"
    )

  cmp-seq sys     ;; Set the compose key to PrintScreen
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough false

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true
)

(defsrc
        mute vold volu                          sys
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9  f10  f11  f12  home end  ins  del
                         ;; Fn+4 == SUSPEND
  `     1     2     3     4      5     6     7     8     9     0    -      =     bspc
                                                                pause ;; Fn+p
  tab     q      w     e     r      t     y     u     i     o     p    [    ]
                 ;; alt+sys : Fn+s
                                                      slck ;; Fn+k
  caps     a      s     d     f      g     h     j     k     l     ;    '    3    ret
                                     pause ;; Fn+b
  lsft  nubs  z     x     c     v      b     n     m      ,    .    /             rsft
  ctl  wkup met   alt           spc                    ralt  rctl      pgup  up  pgdn
                                                                      home     end ;; Fn+
                                                                      lft down rght
)

(defalias sym (around-next (layer-toggle symbols)))
(defalias stf (layer-toggle stuff)
  esp  (around-next (layer-toggle spanish))

)

(defalias
 >>= #(> > = spc)
 1-2 #( 1 [ 2)
 x1-2 (around @sym @1-2)
 y1-2 #(sys 1 [ 2)
 ;; dvorak anti-translation, to make compose keys work: alias a key name to the
 ;; phys key that we need to press on our dvorak keyboard to give the key named
 ;; by the alias
 c i
 C I
 c-cedilla #(sys @c @c)
 C-cedilla #(sys @c @C)
)

(deflayer base
        mute vold volu                          sys
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9  f10  f11  f12  home end  ins  del
                         ;; Fn+4 == SUSPEND
  `     1     2     3     4      5     6     7     8     9     0    -      =     bspc
                                                                pause ;; Fn+p
  tab     '      ,     .     p      y     f     g     c     r     l    /    =
                 ;; alt+sys : Fn+s
                                                      slck ;; Fn+k
  caps     a      o     e     u      i     d     h     t     n     s    -    \    ret
                                     pause ;; Fn+b
  lsft  sys @y1-2 @c-cedilla j @C-cedilla x     b     m      w    v    z            rsft
  ctl  wkup met   alt           spc                    ralt  @sym      pgup  up  pgdn
                                                                      home     end ;; Fn+
                                                                      lft down rght
)

;; ø - sym+w = level3+, (w)
;; å - sym+r = level3+p (l)
;; ® - sym+o = level3+o (r)
(deflayer symbols
        mute vold volu                          sys
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9  f10  f11  f12  home end  ins  del
                         ;; Fn+4 == SUSPEND
  `     1     2     3     4      5     6     7     8     9     0    -      =     bspc
                                                                pause ;; Fn+p
  tab     ä    é    ©  @c-cedilla  t @C-cedilla u     i     o     p    [    ]
                 ;; alt+sys : Fn+s
                                                      slck ;; Fn+k
  caps     @>>=      é     +'   +~   +`   +^     j     k     l     ;    '    3    ret
                                     pause ;; Fn+b
  lsft   \   %     x     c     +"   +,     n     @x1-2      ,    .    /             rsft
  ctl  wkup met   alt           spc                    @sym  rctl      pgup  up  pgdn
                                                                      home     end ;; Fn+
                                                                      lft down rght
)

(deflayer stuff
        mute vold volu                          sys
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9  f10  f11  f12  home end  ins  del
                         ;; Fn+4 == SUSPEND
  `     1     2     3     4      5     6     7     8     9     0    -      =     bspc
                                                                pause ;; Fn+p
  tab     q      w     e     r      t     y     u     i     o     p    [    ]
                 ;; alt+sys : Fn+s
                                                      slck ;; Fn+k
  caps     a      é     d     f      g     h     j     k     l     ;    '    3    ret
                                     pause ;; Fn+b
  lsft   \   %     x     c     v      b     n     m      ,    .    /             rsft
  ctl  wkup met   alt           spc                    @sym  rctl      pgup  up  pgdn
                                                                      home     end ;; Fn+
                                                                      lft down rght
)

(deflayer spanish
        mute vold volu                          sys
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9  f10  f11  f12  home end  ins  del
                         ;; Fn+4 == SUSPEND
  `     1     2     3     4      5     6     7     8     9     0    -      =     bspc
                                                                pause ;; Fn+p
  tab     q      w     e     r      t     y     u     i     o     p    [    ]
                 ;; alt+sys : Fn+s
                                                      slck ;; Fn+k
  caps     á      s     d     f      g     h     j     k     l     ;    '    3    ret
                                     pause ;; Fn+b
  lsft   \   z     @sym     c     v      b     n     ¡      ,    .    /             rsft
  ctl  wkup met   alt           spc                    ralt  rctl      pgup  up  pgdn
                                                                      home     end ;; Fn+
                                                                      lft down rght
)
